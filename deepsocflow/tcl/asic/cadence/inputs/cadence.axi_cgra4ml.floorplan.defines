####################################
##      Floorplan Parameters      ##
####################################
set design(floorplan_ratio)         0.70
set design(floorplan_utilization)   0.70
set design(floorplan_space_to_core) "20.0 20.0 20.0 20.0" ; # Note that this should be passed as four arguments and  
                                                # not as one Therefore, use the expand list {*} operator!

####################################
##        Pin Definition          ##
####################################
set design(CLK_PIN_START_OFFSET)      250
set design(LEFT_PINS_START_OFFSET)    100
set design(LEFT_PINS_END_OFFSET)      100
set design(TOP_PINS_START_OFFSET)     210
set design(TOP_PINS_END_OFFSET)       90
set design(RIGHT_PINS_START_OFFSET)   80
set design(RIGHT_PINS_END_OFFSET)     130
set design(BOTTOM_PINS_START_OFFSET)  100
set design(BOTTOM_PINS_END_OFFSET)    210

set design(CLOCK_PIN)          {clk} 
set design(TOP_INPUT_PINS)     {rstn m_axi_pixel_* }
set design(LEFT_INPUT_PINS)    {m_axi_weights_* }
set design(BOTTOM_OUTPUT_PINS) {m_axi_output_* }  
set design(RIGHT_INPUT_PINS)   {s_axil_*}

set D12_db [lindex [get_db layers]  12]
set D10_db  [lindex [get_db layers] 10]
set D9_db  [lindex [get_db layers]  9]

set design(pin_width_d12) [expr  2*[get_db $D12_db .min_width]]
set design(pin_width_d10) [expr  2*[get_db $D10_db .min_width]]
set design(pin_width_d9)  [expr  2*[get_db $D9_db .min_width]]

####################################
##      Well Tap Definition       ##
####################################
set tech(FILLTIE_CELL) [get_db / .base_cells -if {.base_name == "*FILLTIE*"}]
regsub {^base_cell:} $tech(FILLTIE_CELL) "" tech(FILLTIE_CELL)

####################################
##     Power Grid Definitions     ##
####################################
set design(upper_core_ring_nets)        "$design(digital_vdd) $design(digital_gnd)"
set IB_db                               [lindex [get_db layers] 14]
set IA_db                               [lindex [get_db layers] 13]
set design(upper_core_ring_layers)      "bottom [get_db $IA_db .name] top [get_db $IA_db .name] right [get_db $IB_db .name] left [get_db $IB_db .name]"
set design(upper_core_ring_width)       [expr 6*[get_db $IB_db .min_width]]
set design(upper_core_ring_spacing)     [expr  3*[get_db $IB_db .min_spacing]]
set design(upper_core_ring_offset)      5

set design(lower_core_ring_nets)        "$design(digital_vdd) $design(digital_gnd)"
set M4_db                               [lindex [get_db layers] 4]
set M3_db                               [lindex [get_db layers] 3]
set design(lower_core_ring_layers)      "bottom [get_db $M3_db .name] top [get_db $M3_db .name] right [get_db $M4_db .name] left [get_db $M4_db .name]"
set design(lower_core_ring_width)       0.20;#[expr 9*[get_db $M4_db .min_width]]
set design(lower_core_ring_spacing)     [expr  15*[get_db $M4_db .min_spacing]]
set design(lower_core_ring_offset)      2

set design(M14_stripes_width)     [expr 6*[get_db $IB_db .min_width]]
set design(M14_stripes_spacing)   [expr 3*[get_db $IB_db .min_spacing]]
set design(M14_stripes_interval)  30
set design(M14_stripes_nets)      "$design(digital_vdd) $design(digital_gnd)"

set design(M13_stripes_width)     [expr 6*[get_db $IB_db .min_width]]
set design(M13_stripes_spacing)   [expr 3*[get_db $IB_db .min_spacing]]
set design(M13_stripes_interval)  43
set design(M13_stripes_nets)      "$design(digital_vdd) $design(digital_gnd)"

set M5_db                         [lindex [get_db layers] 5]
set design(block_ring_nets)       "$design(digital_vdd) $design(digital_gnd)"
set design(block_ring_layers)     "bottom [get_db $M5_db .name] top [get_db $M5_db .name] right [get_db $M4_db .name] left [get_db $M4_db .name]"
set design(block_ring_width)      [expr 10*[get_db $M4_db .min_width]]
set design(block_ring_spacing)    [expr 15*[get_db $M4_db .min_spacing]]
set design(block_ring_tb_offset)  [expr 50*[get_db $M4_db .min_spacing]]
set design(block_ring_rl_offset)  [expr 70*[get_db $M4_db .min_spacing]]

set D6_db                             [lindex [get_db layers] 6]
set design(sram_stripes_nets)         "$design(digital_gnd) $design(digital_vdd)"
set design(sram_stripes_flipped_nets) "$design(digital_vdd) $design(digital_gnd)"
set design(sram_stripes_layers)       $krg_iu_vars(layer_name,6)
set design(sram_stripes_width)        [expr 8*[get_db $D6_db .min_width]]
set design(sram_stripes_spacing)      [expr  7*[get_db $D6_db .min_spacing]]
set design(sram_stripes_interval)     7
set design(sram_stripes_interval_dma) 4.1
set design(sram_stripes_start_offset) 5.2
set design(sram_dma_stripes_start_offset) 5.2
set design(sram_dma_stripes_stop_offset)  5.2
set design(sram_stripes_stop_offset)      8.2
set design(sram_edge_stripes_stop_offset) 5.2

set design(M4_stripes_width)          [expr 13*[get_db $M4_db .min_width]]
set design(M4_stripes_spacing)        [expr 70*[get_db $M4_db .min_spacing]]
set design(M4_stripes_interval)       34
set design(M4_last_stripes_interval)  32
set design(M4_stripes_nets)           "$design(digital_vdd) $design(digital_gnd)"

# set design(M5_stripes_width)     [expr 15*[get_db $M5_db .min_width]]
# set design(M5_stripes_spacing)   [expr7*[get_db $D6_db .min_spacing]]
# set design(M5_stripes_interval)  28
# set design(M5_stripes_nets)      "$design(digital_vdd) $design(digital_gnd)"

set stdRowHeight                    [get_db designs .core_site.size.y]
set design(M3_stripes_nets)         "$design(digital_gnd) $design(digital_vdd)"
set design(M3_stripes_layers)       $krg_iu_vars(layer_name,3)
set design(M1_stripes_width)        0.042
set design(M3_stripes_width)        0.030
set design(M3_stripes_spacing)      [expr $stdRowHeight - $design(M1_stripes_width)]
set design(M3_stripes_interval)     [expr $stdRowHeight*2]
set design(M3_stripes_start_offset) -0.02
set design(M3_stripes_stop_offset)  -0.27

set stdRowWidth                      [get_db designs .core_site.size.x]
set design(M2_stapling_nets)         "$design(digital_gnd) $design(digital_vdd)"
set design(M2_stapling_layers)       $krg_iu_vars(layer_name,2)
set design(M2_stapling_width)        0.032
set design(M2_stapling_spacing)      [expr $stdRowHeight - $design(M2_stapling_width)]
set design(M2_stapling_n_cpp)        [expr $stdRowWidth*12]
set design(M2_stapling_interval)     $design(M2_stapling_n_cpp)
set design(M2_stapling_length)       0.090
set design(M2_stapling_offset)       0.045
set design(M2_stapling_pitch)        "$stdRowHeight:1"
set design(M2_stapling_ref_layer)    $krg_iu_vars(layer_name,1)
set design(M2_stapling_parameters)   [list $design(M2_stapling_length) $design(M2_stapling_offset) $design(M2_stapling_pitch) $design(M2_stapling_ref_layer)]

proc krg_select_srams_weights {sram_bank_index sram_row_index} {
    deselect_obj -all
    select_obj "ENGINE_WEIGHTS_ROTATOR/i0[$sram_bank_index].col_RAM[$sram_row_index].BRAM_BRAM_sam5_sp_sram_weight \
                ENGINE_WEIGHTS_ROTATOR/i0[$sram_bank_index].col_RAM[[expr $sram_row_index + 1]].BRAM_BRAM_sam5_sp_sram_weight \
                ENGINE_WEIGHTS_ROTATOR/i0[$sram_bank_index].col_RAM[[expr $sram_row_index + 2]].BRAM_BRAM_sam5_sp_sram_weight \
                ENGINE_WEIGHTS_ROTATOR/i0[$sram_bank_index].col_RAM[[expr $sram_row_index + 3]].BRAM_BRAM_sam5_sp_sram_weight"
}

proc krg_select_srams_edge {} {
    deselect_obj -all
    select_obj "ENGINE_PIXELS_RAM_sam5_sp_sram_edge"
}

proc krg_select_srams_dma {sram_row_index} {
    deselect_obj -all
    select_obj "CONTROLLER_sdp_ram_g[$sram_row_index].ram_i_sam5_2p_sram_dma \
                CONTROLLER_sdp_ram_g[[expr $sram_row_index + 1]].ram_i_sam5_2p_sram_dma \
                CONTROLLER_sdp_ram_g[[expr $sram_row_index + 2]].ram_i_sam5_2p_sram_dma"
}

proc krg_select_srams_dma_last {} {
    deselect_obj -all
    select_obj "CONTROLLER_sdp_ram_g[6].ram_i_sam5_2p_sram_dma \
                CONTROLLER_sdp_ram_g[7].ram_i_sam5_2p_sram_dma"
}

proc krg_add_stripes_to_selected_sram {stripes_nets stripes_spacing_value stripe_start_offset_value stripe_stop_offset_value io_stripe_enable io_stripe_side} {
    global design krg_iu_vars

    set srams_rects [get_db selected .bbox]
    set srams_bbox  [get_computed_shapes -output rect $srams_rects]
    while {[llength $srams_bbox] == 1} {
        set srams_bbox [lindex $srams_bbox 0]
    }
    lassign $srams_bbox llx lly urx ury
    set margin 1
    set expanded_srams_bbox [list \
        [expr {$llx - $margin}] \
        [expr {$lly - $margin}] \
        [expr {$urx + $margin}] \
        [expr {$ury + $margin}]]
    
    add_stripes -nets $stripes_nets -layer $design(sram_stripes_layers) \
        -direction vertical \
        -width $design(sram_stripes_width) \
        -spacing $design(sram_stripes_spacing) \
        -set_to_set_distance $stripes_spacing_value \
        -area $expanded_srams_bbox \
        -start_from left \
        -start_offset $stripe_start_offset_value \
        -stop_offset $stripe_stop_offset_value \
        -switch_layer_over_obs true -max_same_layer_jog_length 2 \
        -block_ring_top_layer_limit $krg_iu_vars(layer_name,6) \
        -block_ring_bottom_layer_limit $krg_iu_vars(layer_name,5) \
        -use_wire_group 0 -snap_wire_center_to_grid grid
    
    if {$io_stripe_enable} {
        add_stripes -nets $design(sram_stripes_nets) -layer $design(sram_stripes_layers) \
            -direction vertical \
            -width $design(sram_stripes_width) \
            -spacing $design(sram_stripes_spacing) \
            -number_of_sets 1 \
            -area $expanded_srams_bbox \
            -start_from $io_stripe_side \
            -start_offset 3.5 \
            -switch_layer_over_obs true -max_same_layer_jog_length 2 \
            -block_ring_top_layer_limit $krg_iu_vars(layer_name,6) \
            -block_ring_bottom_layer_limit $krg_iu_vars(layer_name,5) \
            -use_wire_group 0 -snap_wire_center_to_grid grid
    }
    deselect_obj -all
}

