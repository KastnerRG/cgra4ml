##############################################################################
# Project   : DeepSoCFlow CGRA4ML
# Script    : cadence.axi_cgra4ml.defines
# Purpose   : Project-specific variable definitions for all Cadence EDA flows
##############################################################################
# Author    : Ravidu Munasinghe <raviduhm@gmail.com>
# Org       : Kastner Research Group | ENTC UoM
# Created   : 2026-05-14
# Modified  : 2026-06-12
##############################################################################
# Version   : 2.0
# Status    : In Progress
##############################################################################
#
# Description:
#   Defines all design()/tech() variables consumed by genus.tcl, innovus.tcl,
#   and cadence.settings.tcl. Covers flow config, technology, clocks, SDC
#   constraints, file paths, MMMC views, power nets, PnR rules, simulation
#   backannotation settings, and suppressed messages.
#
##############################################################################
# Sections:
#   Initial settings   - Flow type flags (mmmc, phys_synth, timing_lib, lp)
#   Technology         - Technology node identifiers
#   Port definitions   - Clock, reset, scan port names from RTL
#   SDC settings       - IO delays, clock uncertainty, DRV, routing layers
#   Files and paths    - All input/output directory and file path variables
#   Global nets        - Power/ground net names
#   PnR rules          - Well-tap rule
#   Simulation         - VCD and power report backannotation settings
#   Message suppression - Genus/Innovus warning filters
##############################################################################
# TODO:
#   Major Revisions
#   [ ] Add Low Power Support
#   [] Add Genus Suppress Messages
#   [ ] Add Innovus Suppress Messages
#   [ ] Add Tempus Suppress Messages
#   [ ] Add multi-clock support (MULTI_CLOCK_DESIGN currently hardcoded "no")
#   [ ] Add SRAM technology definitions when SRAM_TECHNOLOGY != "None"
#   [ ] Add IO technology definitions when IO_TECHNOLOGY != "None"
#   Minor Revisions
#   [ ] Add UPF/CPF power intent file paths when low_power_enabled = "yes"
#   [ ] Add tech(EXTERNAL_SDC_LOAD) for fullchip
##############################################################################
# WARNING:
#   For Samsung 5nm - Metal Layers {M1, M2, M3, M4, D5, D6, D7, D8, D9, D10, D11, D12, IA, IB}
#   Before running any flow, verify ALL file paths in this file are correct
#   for your environment. Key paths to check:
#     - paths(PDK_ROOT)     : path to pdks
#     - env(INNOVUS)        : path to Cadence Innovus binary
#     - design(project_root): resolves relative to $env(PWD) — run from the
#                             correct working directory (run/work/genus_runs)
#     - design(libraries_dir): technology library files must exist here
##############################################################################
# Usage:
#   source cadence.cgra4ml.defines -quiet in genus.tcl
#   Requires $runtype, $design(TOPLEVEL), $FREQ, $debug_file to be set first
##############################################################################

################################################
#               Initial Tcl Settings
################################################
####### Hierarchy
set design(FULLCHIP_OR_MACRO) "MACRO";
set design(HAS_SCAN)          "no";

set low_power_enabled       "no"
set timing_lib_type         "nldm";         # "nldm"      - Non Linear Model Libs 
                                            # "ccs_ocv"   - CCS, LVF and AOCV libs

################################################
#               Technology Definition
################################################
set TECHNOLOGY            "SAM5_TECH"
set SC_TECHNOLOGY         "SAM5_SC"
set SRAM_TECHNOLOGY       "None"
set IO_TECHNOLOGY         "None"

################################################
#               Port Definition (From Verilog)
################################################
######  Clocks
set design(MULTI_CLOCK_DESIGN) "no"

set design(CLK_NAME)    "CLK"
    set design(clock_list)  [list $design(CLK_NAME)]
set design(CLK_PORT)    "clk"
    set design(clock_port_list) [list $design(CLK_PORT)]
set design(CLK_PERIOD)  [expr {$FREQ/1000}]; # Extract from config_hw.tcl generated by example.py
    set design(clock_period_list) [list $design(CLK_PERIOD)]

######  Reset
set design(RST_PORT)    "rstn"

######  Scan
if {$design(HAS_SCAN) == "no"} {
    set design(SCAN_MODE_PORT) ""
}

################################################
#               SDC Settings
################################################
# IO Constraints
set design(INPUT_DELAY)       [expr $design(CLK_PERIOD)/4.0]
set design(OUTPUT_DELAY)      [expr $design(CLK_PERIOD)/4.0]
set design(INPUT_TRANSITION)  [expr $design(CLK_PERIOD)/5.0] ; # Maximum Transition Time according Liberty Data sheet = min(20% of Clock, Max transition characterized on Table)

# Clock Constraints
set design(CLOCK_UNCERTAINTY)  0.125 ; # In ns for SDC (will appear in ps for get_db)

# DRV Constraints
set design(MAX_TRANSITION)   [expr $design(CLK_PERIOD)/5.0] ; # Maximum Transition Time according Liberty Data sheet = min(20% of Clock, Max transition characterized on Table)

# CTS Constraints
set design(CLOCK_MAX_TRANSITION) [expr $design(CLK_PERIOD)/5.0]
# set design(CLOCK_MAX_FANOUT) 
# set design(CLOCK_MAX_CAPACITANCE) 

# Routing Constraints
set design(MIN_ROUTE_LAYER) M1
set design(MAX_ROUTE_LAYER) IB

################################################
#               Files and Paths
################################################
set design(workdir)                              $env(PWD)

set env(innovus_exe)                             "/tools/cadence/DDI231/bin/innovus"   
set design(innovus_dir)                          "$env(PWD)/innovus_dir"  
set design(conformal_dir)                        "$env(PWD)/conformal_dir"                   

set paths(PDK_ROOT)                              "$env(PWD)/../../../../../PDK"
set design(project_root)                         "$env(PWD)/../../../../"
set design(asic_root)                            "$design(project_root)/deepsocflow/tcl/asic/cadence"
set design(inputs_dir)                           "$design(asic_root)/inputs"
set design(libraries_dir)                        "$design(asic_root)/libraries"

set design(hdl_search_paths)                     [list $env(PWD) "$design(workdir)/../../" "$design(project_root)/deepsocflow/rtl" \
                                                "$design(project_root)/deepsocflow/rtl/ext" "$design(project_root)/deepsocflow/rtl/asic"]
set design(read_svh_hdl_list)                    "$design(workdir)/../../$design(TOPLEVEL)_src_list_svh.txt"
set design(read_sv_hdl_list)                     "$design(workdir)/../../$design(TOPLEVEL)_src_list_sv.txt"
set design(read_v_hdl_list)                      "$design(workdir)/../../$design(TOPLEVEL)_src_list_v.txt"

set design(scripts_dir)                          "$design(asic_root)/scripts"
set design(compare_dir)                          "$design(project_root)/run/asic/cadence/compare"
set design(messages_dir)                         "$design(project_root)/run/asic/cadence/messages"
set design(reports_syn_dir)                       "$design(project_root)/run/asic/cadence/reports/genus_run_[format "%02d" $genus_run_counter]"

set design(export_syn_dir)                       "$design(workdir)/exports"
set design(dbs_syn_dir)                          "$design(workdir)/dbs"

set design(postsyn_lec_netlist_ispatial)         "$design(export_syn_dir)/$design(TOPLEVEL)_ispatial.postsyn.lec.v"
set design(postsyn_netlist_ispatial)             "$design(export_syn_dir)/$design(TOPLEVEL)_ispatial.postsyn.v"
set design(postsyn_sdc_ispatial)                 "$design(export_syn_dir)/$design(TOPLEVEL)_ispatial.postsyn.sdc"
set design(postsyn_sdf_ispatial)                 "$design(export_syn_dir)/$design(TOPLEVEL)_ispatial.postsyn.sdf"

set design(postsyn_netlist_rtl_flow)             "$design(export_syn_dir)/$design(TOPLEVEL)_rtl_flow.postsyn.v"
set design(postsyn_sdc_rtl_flow)                 "$design(export_syn_dir)/$design(TOPLEVEL)_rtl_flow.postsyn.sdc"
set design(postsyn_sdf_rtl_flow)                 "$design(export_syn_dir)/$design(TOPLEVEL)_rtl_flow.postsyn.sdf"

set design(floorplan_def)                        "$env(PWD)/../../innovus/innovus_run_[format "%02d" $innovus_run_counter]/exports/$design(TOPLEVEL).floorplan.def"

if { $runtype == "pnr" } {
    set design(prev_genus_run)                   "$env(PWD)/../../genus/genus_run_[format "%02d" $genus_run_counter]"
    set design(export_syn_dir)                   "$design(prev_genus_run)/exports"
    set design(dbs_syn_dir)                      "$design(prev_genus_run)/dbs"

    set design(postsyn_netlist_ispatial)         "$design(export_syn_dir)/$design(TOPLEVEL)_ispatial.postsyn.v"
    set design(postsyn_sdc_ispatial)             "$design(export_syn_dir)/$design(TOPLEVEL)_ispatial.postsyn.sdc"
    set design(postsyn_sdf_ispatial)             "$design(export_syn_dir)/$design(TOPLEVEL)_ispatial.postsyn.sdf"

    set design(postsyn_netlist_rtl_flow)         "$design(export_syn_dir)/$design(TOPLEVEL)_rtl_flow.postsyn.v"
    set design(postsyn_sdc_rtl_flow)             "$design(export_syn_dir)/$design(TOPLEVEL)_rtl_flow.postsyn.sdc"
    set design(postsyn_sdf_rtl_flow)             "$design(export_syn_dir)/$design(TOPLEVEL)_rtl_flow.postsyn.sdf"

    set design(export_pnr_dir)                   "$design(workdir)/exports"
    set design(dbs_pnr_dir)                      "$design(workdir)/dbs"
    set design(reports_pnr_dir)                  "$design(project_root)/run/asic/cadence/reports/innovus_run_[format "%02d" $innovus_run_counter]"
    set design(postroute_netlist)                "$design(export_pnr_dir)/$design(TOPLEVEL).pnr.v"
    set design(postroute_sdf)                    "$design(export_pnr_dir)/$design(TOPLEVEL).pnr.sdf"

    # Save floorplan from innovus to parallel genus run 
    set design(floorplan_check)                      "$design(export_pnr_dir)/$design(TOPLEVEL).floorplan_check.rpt"
    set design(clock_tree_spec)                      "$design(inputs_dir)/cadence.$design(TOPLEVEL).clock_tree.spec"
    set design(floorplan_def)                        "$design(export_pnr_dir)/$design(TOPLEVEL).floorplan.def"
}

set design(functional_sdc)                       "$design(inputs_dir)/cadence.$design(TOPLEVEL).sdc"
set design(mmmc_nldm_view_file)                  "$design(inputs_dir)/cadence.$design(TOPLEVEL).nldm.mmmc"
set design(mmmc_ocv_view_file)                   "$design(inputs_dir)/cadence.$design(TOPLEVEL).ocv.mmmc"

# set design(io_file)                            "$design(inputs_dir)/$design(TOPLEVEL).io"
# set design(UPF_file)                           "$design(inputs_dir)/$design(TOPLEVEL).upf"
# set design(CPF_file)                           "$design(inputs_dir)/$design(TOPLEVEL).cpf"
# set design(dont_use_file)                      "$design(inputs_dir)/$design(TOPLEVEL).dont_use"
# set design(size_only_file)                     "$design(inputs_dir)/$design(TOPLEVEL).size_only"

################################################
#               MMMC
################################################
if { $runtype == "synthesis" } {
    set design(selected_setup_analysis_views)      wc_analysis_view
    set design(selected_hold_analysis_views)       bc_analysis_view
} elseif { $runtype == "pnr" } {
    set design(selected_setup_analysis_views)      "wc_analysis_view tc_analysis_view"
    set design(selected_hold_analysis_views)       "bc_analysis_view tc_analysis_view"
}

#set design(selected_power_analysis_views)         "wc_analysis_view"
#set design(selected_leakage_analysis_views)       "wc_analysis_view"
#set design(selected_dynamic_power_analysis_views) "wc_analysis_view"

################################################
#               Global Nets
################################################
set design(digital_gnd) "GND"
set design(all_ground_nets) $design(digital_gnd)
set design(digital_vdd) "VDD"
set design(all_power_nets) $design(digital_vdd)

if {$design(FULLCHIP_OR_MACRO) == "FULLCHIP"} {
    set design(io_gnd) "gnd"
    lappend design(all_ground_nets) $design(io_gnd)
    set design(io_vdd) "vddio"
    lappend design(all_power_nets) $design(io_vdd)
}

################################################
#               PnR Rules
################################################
set design(WELLTAP_RULE) 15

################################################
#               Simulation and Backannotation
################################################
# For Backannotation and Power Reporting
# set design(vcd_file)              "$design(export_syn_dir)/cadence/$design(tb_name).vcd"
# set design(power_report_flow)     "vcd" ; # "vcd"
# set design(power_report_period)     2
# set design(power_report_start_time) 0
# set design(power_report_end_time)   1500

################################################
#               Get rid of annoying messages
################################################
# Stop reporting messages maximum printed exceeded
set design(DESIGN_SUPPRESS_MESSAGES_GENUS)     "MESG-6 MESG-11 TUI-82"
# Stop reporting super-threading and wrote dofile/fv info
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "ST-110 ST-112 ST-120 ST-128 CFM-1 CFM-5"
# Stop reporting run parallel commands and joules info
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "RPT-16 RPT-303 RPT-310"
# Stop reporting elaboration of multi-dimensional array
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "CDFG-250"
# Stop reporting implementation inference (chipWare)
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "CWD-19 CWD-21 CWD-36"
# Stop reporting Replaced logic with a constant value
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "CDFG-771"
# Stop reporting unreachable case statements
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "CDFG-472"
# Stop common subexpression info messages
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "CDFG-738 CDFG-739"
# Stop sum-of-products logic to be optimized during syn_generic info messages
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "CDFG-769"
# Stop Optimized the MUX created for array read/write or variable shifter
lappend design(DESIGN_SUPPRESS_MESSAGES_GENUS) "CDFG-893"

# # set design(DESIGN_SUPPRESS_MESSAGES_INNOVUS) ""
# # Stop reporting mismatch in voltage between IOs and sta...
# # lappend design(DESIGN_SUPPRESS_MESSAGES_INNOVUS) "TMPMSM.."

################################################
#               Print values to debug file
################################################
set df [open $debug_file w]
puts $df "\n****************************************************"
puts $df "* Values loaded from $design(TOPLEVEL).defines.tcl *"
puts $df "\n****************************************************"
foreach var {TECHNOLOGY SC_TECHNOLOGY SRAM_TECHNOLOGY IO_TECHNOLOGY} {
    puts $df "$var = \t[set $var]"
}

foreach dic {design} {
    foreach key [array names $dic] {
        puts $df "${dic}(${key}) = \t [set ${dic}([set key])]"  
    }
}
